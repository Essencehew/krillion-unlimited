# Copy to .env for local dev (npm run dev). On Vercel, add these under
# Project → Settings → Environment Variables instead.

# Supabase (free): Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "secret" key (starts with sb_secret_). Older projects: the service_role key also works.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Optional: Google Gemini free API key (https://aistudio.google.com/apikey)
# Lets the game confirm brand-new answers and unlock the ONE IN A KRILLION tier.
GEMINI_API_KEY=
